<Project Sdk="Microsoft.NET.Sdk">

  <!-- WinUI 3, unpackaged and self-contained: builds with the .NET SDK alone (no Visual Studio). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Chili</RootNamespace>
    <AssemblyName>Chili</AssemblyName>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- Needed for dotnet publish to include the compiled XAML (.xbf) and Chili.pri. -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <SelfContained>true</SelfContained>
    <Platforms>x64;ARM64</Platforms>
    <Platform Condition="'$(Platform)' == '' Or '$(Platform)' == 'AnyCPU'">x64</Platform>
    <RuntimeIdentifier Condition="'$(Platform)' == 'x64'">win-x64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(Platform)' == 'ARM64'">win-arm64</RuntimeIdentifier>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/Chili.ico</ApplicationIcon>
    <!-- Program.cs has Main: single instance + redirection of .vv files and spice:// links. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <Product>Chili</Product>
    <Description>SPICE client and Proxmox VE companion</Description>
    <Version>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)..\..\..\VERSION').Trim())</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.7.0" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2957" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Chili.Core\Chili.Core.csproj" />
  </ItemGroup>

  <!-- remote-viewer from MSYS2, collected by windows/scripts/bundle-viewer.sh, ships as viewer\. -->
  <PropertyGroup>
    <ViewerBundle>$(MSBuildThisFileDirectory)..\..\build\viewer\</ViewerBundle>
  </PropertyGroup>
  <!-- Plain copies, not Content items: WinUI's resource indexer would scan the .mo files. -->
  <Target Name="CopyViewerBundle" AfterTargets="Build" Condition="Exists('$(ViewerBundle)bin\remote-viewer.exe')">
    <ItemGroup><ViewerFile Include="$(ViewerBundle)**\*" /></ItemGroup>
    <Copy SourceFiles="@(ViewerFile)" DestinationFolder="$(OutDir)viewer\%(RecursiveDir)" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="PublishViewerBundle" AfterTargets="Publish" Condition="Exists('$(ViewerBundle)bin\remote-viewer.exe')">
    <ItemGroup><ViewerFile Include="$(ViewerBundle)**\*" /></ItemGroup>
    <Copy SourceFiles="@(ViewerFile)" DestinationFolder="$(PublishDir)viewer\%(RecursiveDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
