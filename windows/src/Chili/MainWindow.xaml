<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Chili.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Chili">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <NavigationView
        x:Name="Nav"
        PaneDisplayMode="Left"
        IsBackButtonVisible="Collapsed"
        IsSettingsVisible="False"
        IsPaneToggleButtonVisible="False"
        OpenPaneLength="230"
        SelectionChanged="OnSelectionChanged">
        <NavigationView.FooterMenuItems>
            <NavigationViewItem x:Name="AddServerItem" SelectsOnInvoked="False" Tapped="OnAddServer">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Add" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.FooterMenuItems>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <!-- A newer Chili is available (Services/Updater.cs). -->
            <InfoBar x:Name="UpdateBar" Severity="Informational" IsOpen="False" Margin="12,8,12,0">
                <InfoBar.ActionButton>
                    <Button x:Name="UpdateButton" Click="OnUpdateNow" Style="{StaticResource AccentButtonStyle}" />
                </InfoBar.ActionButton>
                <InfoBar.Content>
                    <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,0,0,8">
                        <HyperlinkButton x:Name="UpdateNotes" Click="OnUpdateNotes" Padding="0" />
                        <ProgressBar x:Name="UpdateProgress" Width="200" Visibility="Collapsed" VerticalAlignment="Center" />
                    </StackPanel>
                </InfoBar.Content>
            </InfoBar>
            <ContentControl
                x:Name="Detail"
                Grid.Row="1"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch" />
        </Grid>
    </NavigationView>
</Window>
