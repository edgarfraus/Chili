<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Chili.Views.ServerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Chili.ViewModels"
    xmlns:views="using:Chili.Views">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title + toolbar -->
        <Grid Padding="24,14,12,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="TitleText" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
            <CommandBar Grid.Column="1" x:Name="Toolbar" DefaultLabelPosition="Right" Background="Transparent"
                        IsDynamicOverflowEnabled="False">
                <AppBarButton x:Name="RefreshButton" Icon="Refresh" Click="OnRefresh" />
                <AppBarButton x:Name="LogoutButton" Click="OnLogout">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xF3B1;" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton x:Name="EditButton" Click="OnEdit">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE9E9;" />
                    </AppBarButton.Icon>
                </AppBarButton>
            </CommandBar>
        </Grid>

        <!-- Logged out / two-factor -->
        <StackPanel x:Name="LoginPanel" Grid.Row="1" Spacing="14" HorizontalAlignment="Center" VerticalAlignment="Center"
                    MaxWidth="420" Margin="40">
            <FontIcon Glyph="&#xE968;" FontSize="40" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock x:Name="LoginTitle" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
            <TextBlock x:Name="LoginUser" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
            <PasswordBox x:Name="SecretBox" Width="280" KeyDown="OnLoginKeyDown" />
            <TextBox x:Name="OtpBox" Width="280" KeyDown="OnLoginKeyDown" Visibility="Collapsed" InputScope="Number" />
            <TextBlock x:Name="OtpHint" Width="280" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="Collapsed" />
            <TextBlock x:Name="LoginError" TextWrapping="Wrap" TextAlignment="Center" Visibility="Collapsed"
                       Foreground="{ThemeResource SystemFillColorCriticalBrush}" IsTextSelectionEnabled="True" />
            <Grid HorizontalAlignment="Center">
                <Button x:Name="LoginButton" Style="{StaticResource AccentButtonStyle}" MinWidth="120" Click="OnLogin" />
                <ProgressRing x:Name="LoginProgress" Width="20" Height="20" IsActive="False" />
            </Grid>
        </StackPanel>

        <!-- VM list -->
        <Grid x:Name="ListPanel" Grid.Row="1" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Padding="16,6,16,10" ColumnSpacing="16" BorderThickness="0,0,0,1"
                  BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="FilterBox" TextChanged="OnFilterChanged" />
                <CheckBox x:Name="ShowStoppedBox" Grid.Column="1" Click="OnShowStopped" />
                <StackPanel x:Name="ErrorBanner" Grid.Column="2" Orientation="Horizontal" Spacing="6"
                            HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed">
                    <FontIcon Glyph="&#xE7BA;" FontSize="14" Foreground="{StaticResource WarningBrush}" />
                    <TextBlock x:Name="ErrorText" Foreground="{StaticResource WarningBrush}" TextTrimming="CharacterEllipsis" MaxWidth="420" />
                </StackPanel>
            </Grid>
            <TextBlock x:Name="EmptyText" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <ListView x:Name="VmList" Grid.Row="1" SelectionMode="None" Padding="8,4,8,8"
                      IsItemClickEnabled="False" DoubleTapped="OnRowDoubleTapped">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="12,0,8,0" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:VmItem">
                        <Grid ColumnSpacing="12" MinHeight="64" Padding="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="52" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid VerticalAlignment="Center" ToolTipService.ToolTip="{x:Bind Vm.Status, Mode=OneWay}">
                                <Ellipse Width="9" Height="9" Fill="{StaticResource RunningBrush}" Visibility="{x:Bind RunningVisibility, Mode=OneWay}" />
                                <Ellipse Width="9" Height="9" Fill="{ThemeResource ControlStrongFillColorDisabledBrush}" Visibility="{x:Bind StoppedDotVisibility, Mode=OneWay}" />
                            </Grid>
                            <TextBlock Grid.Column="1" Text="{x:Bind IdText, Mode=OneWay}" VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="1">
                                <TextBlock Text="{x:Bind Name, Mode=OneWay}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind Details, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center"
                                        Visibility="{x:Bind RunningVisibility, Mode=OneWay}">
                                <views:Dial Value="{x:Bind Cpu, Mode=OneWay}" Label="CPU" ToolTipService.ToolTip="{x:Bind CpuTip, Mode=OneWay}" />
                                <views:Dial Value="{x:Bind Memory, Mode=OneWay}" Label="RAM" ToolTipService.ToolTip="{x:Bind MemoryTip, Mode=OneWay}" />
                                <StackPanel Width="84" VerticalAlignment="Center" Spacing="2" ToolTipService.ToolTip="{x:Bind NetworkTip}">
                                    <TextBlock Text="{x:Bind NetInText, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{x:Bind NetOutText, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <ProgressRing Width="20" Height="20" IsActive="{x:Bind Busy, Mode=OneWay}"
                                              Visibility="{x:Bind BusyVisibility, Mode=OneWay}" />
                                <Button Content="{x:Bind StartLabel}" Click="OnStart" Visibility="{x:Bind StoppedVisibility, Mode=OneWay}" />
                                <Button Content="{x:Bind ConnectLabel, Mode=OneWay}" Click="OnConnect" Style="{StaticResource AccentButtonStyle}"
                                        Visibility="{x:Bind ActionsVisibility, Mode=OneWay}" MinWidth="96" />
                            </StackPanel>
                            <Button Grid.Column="5" Click="OnMore" VerticalAlignment="Center" Background="Transparent" BorderThickness="0"
                                    Padding="8,6" Visibility="{x:Bind ActionsVisibility, Mode=OneWay}"
                                    ToolTipService.ToolTip="{x:Bind MoreTip}">
                                <FontIcon Glyph="&#xE712;" FontSize="16" />
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <!-- Connecting (no list yet) -->
        <StackPanel x:Name="ConnectingPanel" Grid.Row="1" Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="Collapsed">
            <ProgressRing IsActive="True" />
            <TextBlock x:Name="ConnectingText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
    </Grid>
</UserControl>
